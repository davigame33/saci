-- ON / OFF
local ligado = false

switch.MouseButton1Click:Connect(function()
	ligado = not ligado

	if ligado then
		-- Botão fica VERMELHO no ON
		TweenService:Create(
			knob,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(1, -27, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			}
		):Play()

		TweenService:Create(
			switch,
			TweenInfo.new(0.18),
			{BackgroundColor3 = Color3.fromRGB(220, 30, 30)}
		):Play()
	else
		TweenService:Create(
			knob,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(0, 3, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(125, 125, 125)
			}
		):Play()

		TweenService:Create(
			switch,
			TweenInfo.new(0.18),
			{BackgroundColor3 = Color3.fromRGB(20, 20, 20)}
		):Play()
	end
end)

-- Variáveis para salvar a posição original e velocidade original
local originalR6C0 = nil
local originalR15C0 = nil
local originalWalkSpeed = 16

-- Sistema do Efeito Saci (Perna + Velocidade Suave)
local function updateSaci()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	-- Suporte R6
	local torso = character:FindFirstChild("Torso")
	local rightHipR6 = torso and torso:FindFirstChild("Right Hip")
	
	-- Suporte R15
	local upperTorso = character:FindFirstChild("UpperTorso")
	local rightUpperLeg = character:FindFirstChild("RightUpperLeg")
	local rightHipR15 = upperTorso and upperTorso:FindFirstChild("RightHip") or (rightUpperLeg and rightUpperLeg:FindFirstChild("RightHip"))

	if ligado then
		-- Aumenta a velocidade para 45 (ótima para se movimentar sem bugar)
		if humanoid then
			if originalWalkSpeed == 16 and humanoid.WalkSpeed ~= 45 then
				originalWalkSpeed = humanoid.WalkSpeed
			end
			humanoid.WalkSpeed = 45
		end

		-- Perna para cima
		if rightHipR6 then
			if not originalR6C0 then originalR6C0 = rightHipR6.C0 end
			rightHipR6.C0 = CFrame.new(1, 2.5, 0)
		end
		
		if rightHipR15 then
			if not originalR15C0 then originalR15C0 = rightHipR15.C0 end
			rightHipR15.C0 = CFrame.new(0.5, 1.8, 0)
		end
	else
		-- Restaura a velocidade original
		if humanoid then
			humanoid.WalkSpeed = originalWalkSpeed
		end

		-- Restaura a perna original
		if rightHipR6 and originalR6C0 then
			rightHipR6.C0 = originalR6C0
		end
		
		if rightHipR15 and originalR15C0 then
			rightHipR15.C0 = originalR15C0
		end
	end
end

-- Atualiza a cada frame
RunService.RenderStepped:Connect(updateSaci)
