	if ligadoGrafico then
		TweenService:Create(
			knobGrafico,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Position = UDim2.new(1, -16, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }
		):Play()

		TweenService:Create(
			switchGrafico,
			TweenInfo.new(0.18),
			{ BackgroundColor3 = Color3.fromRGB(220, 30, 30) }
		):Play()

		-- Ativa Gráfico de Massinha e FPS Booster
		Lighting.GlobalShadows = false
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") or child:IsA("Atmosphere") then
				child.Enabled = false
			end
		end

		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj:IsDescendantOf(player.Character) then
				obj.Material = Enum.Material.SmoothPlastic
				obj.Reflectance = 0
			elseif obj:IsA("Texture") or obj:IsA("Decal") then
				obj.Transparency = 1
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
				obj.Enabled = false
			end
		end
	else
		TweenService:Create(
			knobGrafico,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Position = UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = Color3.fromRGB(125, 125, 125) }
		):Play()

		TweenService:Create(
			switchGrafico,
			TweenInfo.new(0.18),
			{ BackgroundColor3 = Color3.fromRGB(20, 20, 20) }
		):Play()

		Lighting.GlobalShadows = originalShadows
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") or child:IsA("Atmosphere") then
				child.Enabled = true
			end
		end
	end
end)


----------------------------------------------------
-- LÓGICA EM TEMPO REAL (FPS Counter, Saci e Tela)
----------------------------------------------------
local originalR6C0 = nil
local originalR15C0 = nil
local originalWalkSpeed = 16

local frameCount = 0
local lastTick = tick()

RunService.RenderStepped:Connect(function(dt)
	-- Atualização do FPS Counter
	frameCount = frameCount + 1
	if tick() - lastTick >= 0.5 then
		if ligadoFPS then
			local currentFPS = math.floor(frameCount / (tick() - lastTick))
			textFPS.Text = "FPS: " .. currentFPS
		end
		frameCount = 0
		lastTick = tick()
	end

	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local torso = character:FindFirstChild("Torso")
	local rightHipR6 = torso and torso:FindFirstChild("Right Hip")
	
	local upperTorso = character:FindFirstChild("UpperTorso")
	local rightUpperLeg = character:FindFirstChild("RightUpperLeg")
	local rightHipR15 = upperTorso and upperTorso:FindFirstChild("RightHip") or (rightUpperLeg and rightUpperLeg:FindFirstChild("RightHip"))

	-- Saci
	if ligadoSaci then
		if humanoid then
			if originalWalkSpeed == 16 and humanoid.WalkSpeed ~= 45 then
				originalWalkSpeed = humanoid.WalkSpeed
			end
			humanoid.WalkSpeed = 45
		end

		if rightHipR6 then
			if not originalR6C0 then originalR6C0 = rightHipR6.C0 end
			rightHipR6.C0 = CFrame.new(1, 2.5, 0)
		end
		
		if rightHipR15 then
			if not originalR15C0 then originalR15C0 = rightHipR15.C0 end
			rightHipR15.C0 = CFrame.new(0.5, 1.8, 0)
		end
	else
		if humanoid then
			humanoid.WalkSpeed = originalWalkSpeed
		end

		if rightHipR6 and originalR6C0 then
			rightHipR6.C0 = originalR6C0
		end
		
		if rightHipR15 and originalR15C0 then
			rightHipR15.C0 = originalR15C0
		end
	end

	-- Tela
	if ligadoTela then
		Camera.FieldOfView = 95
	else
		Camera.FieldOfView = 70
	end
end)
